# Copy this file to ".env" and fill in your own keys.
# The .env file is gitignored — never commit real tokens.

# WAQI air-quality token — free from https://aqicn.org/data-platform/token/
# Optional: if blank, the app falls back to CPCB (data.gov.in) and the CAMS model.
VITE_WAQI_TOKEN=your_waqi_token_here

# data.gov.in API key for live CPCB station data — free from https://data.gov.in
# A shared public sample key works for light use; get your own for reliability.
VITE_DATAGOV_KEY=579b464db66ec23bdd000001cdd3946e44ce4aad7209ff7b23ac571b
